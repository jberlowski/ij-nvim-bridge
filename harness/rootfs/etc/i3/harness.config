# Minimal i3 for the harness. Not a desktop — just enough window management
# that IntelliJ lays out correctly and the two editors tile side by side.

font pango:monospace 9

# No bar, no keybindings we depend on: the harness drives everything by RPC.
# A bar would only eat pixels in screenshots.

# Tile horizontally by default so IntelliJ and the nvim terminal sit
# side by side in the live view (HARNESS.md §4) rather than stacking.
default_orientation horizontal
workspace_layout default

# No gaps, no borders: maximise usable pixels and keep screenshots legible.
new_window none
new_float none
hide_edge_borders both

# Focus must not follow the mouse — there is no mouse, and stray focus
# changes would make IntelliJ's editor state non-deterministic.
focus_follows_mouse no

# Keep dialogs floating and centred so they are obvious in a screenshot
# instead of being tiled into a corner.
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="jetbrains-idea" window_type="dialog"] floating enable
